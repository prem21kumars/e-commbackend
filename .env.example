# ==============================================================================
# Enterprise E-Commerce Backend Environment Configuration Template
# Copy this file to .env and customize secrets before starting docker compose.
# ==============================================================================

# Database Configuration (MySQL 8.4)
DB_HOST=mysql-primary
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_password_2026
DB_ROOT_PASSWORD=root_secure_password_2026

# Redis In-Memory Cache
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Message Broker
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Security (Must be at least 64 bytes / 512 bits hex string for HS512)
JWT_SECRET=4c9a72e81d6f3b05a7e28c491d3f5a8b2e1c6d04a9f8e7b3c2d1a0e5f6b8c9d24c9a72e81d6f3b05a7e28c491d3f5a8b2e1c6d04a9f8e7b3c2d1a0e5f6b8c9d2
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Razorpay Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Monitoring & Dashboards
GRAFANA_PASSWORD=admin_secure_2026

