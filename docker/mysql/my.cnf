[mysqld]
# =============================================================================
# Hostinger VPS MySQL 8.4 Production Configuration
# Specification: 16 vCPU, 32 GB RAM, NVMe SSD Storage
# =============================================================================

# Connection Budget & Resource Limits
max_connections                 = 200
max_connect_errors              = 10000
open_files_limit                = 65535
table_open_cache                = 4000
table_definition_cache          = 2000
thread_cache_size               = 64

# InnoDB High-Throughput Memory Allocation
innodb_buffer_pool_size         = 20G
innodb_buffer_pool_instances     = 16
innodb_log_buffer_size          = 64M
innodb_redo_log_capacity        = 4G
innodb_flush_log_at_trx_commit  = 1
innodb_flush_method             = O_DIRECT
innodb_file_per_table           = 1

# I/O Capacity for NVMe Storage
innodb_io_capacity              = 5000
innodb_io_capacity_max          = 10000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8

# GTID & Binary Logging for Replication & PITR Backup
server-id                       = 1
log-bin                         = mysql-bin
binlog_format                   = ROW
binlog_row_image                = FULL
gtid_mode                       = ON
enforce_gtid_consistency        = ON
binlog_expire_logs_seconds      = 604800 # 7 days retention
sync_binlog                     = 1

# Character Set & Collation
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci

# Observability & Slow Query Logging
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/mysql-slow.log
long_query_time                 = 1.0 # Log queries exceeding 1 second
log_queries_not_using_indexes   = 0

# Security
local_infile                    = 0
skip_show_database              = 1

